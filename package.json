{
  "name": "bb-plugin-markwright",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Markwright",
    "description": "Open .md files as a rich document: type / for headings, tables, checklists, callouts, Mermaid diagrams and templates, with no Markdown syntax. Saves keep untouched blocks byte-for-byte and never overwrite an agent's change.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-code-block-lowlight": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "3.2.7"
  },
  "description": "Edit Markdown files like a Word or Notion document, with a / menu, tables, Mermaid diagrams, callouts and templates. Saves change only the blocks you edited.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build"
  }
}
